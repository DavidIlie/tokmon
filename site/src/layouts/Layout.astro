---
import "../styles/tokens.css";
import {
  LICENSE_URL,
  NPM_URL,
  OG_IMAGE_URL,
  RELEASES_URL,
  REPO_SLUG,
  REPO_URL,
  THIRD_PARTY_NOTICES_URL,
} from "../lib/site.ts";

interface Props {
  title: string;
  description: string;
  active?: "home" | "docs" | "download";
}

const { title, description, active = "home" } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={OG_IMAGE_URL} />
    <meta property="og:image:alt" content="Tokmon terminal dashboard with provider usage cards" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/" aria-label="Tokmon home">
          <img class="brand-mark" src="/icon.svg" alt="" width="28" height="28" />
          <span class="brand-word font-display">tokmon</span>
        </a>

        <nav class="nav-links" aria-label="Primary">
          <a href="/#providers">Providers</a>
          <a href="/#surfaces">Surfaces</a>
          <a href="/#themes">Themes</a>
          <a
            href="/docs"
            class="nav-docs"
            aria-current={active === "docs" ? "page" : undefined}
          >Docs</a>
          <a
            href="/download"
            class="nav-download"
            aria-current={active === "download" ? "page" : undefined}
            >Download</a
          >
          <a
            class="star-link"
            href={REPO_URL}
            rel="noopener"
          >
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
            <span class="sr-only">Tokmon on GitHub</span>
            <span class="star-count tnum" data-star-count>Star</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <img src="/icon.svg" alt="" width="22" height="22" />
          <span class="font-display">tokmon</span>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href="/docs">Docs</a>
          <a href={REPO_URL} rel="noopener">GitHub</a>
          <a href={RELEASES_URL} rel="noopener">Releases</a>
          <a href={NPM_URL} rel="noopener">npm</a>
          <a href={THIRD_PARTY_NOTICES_URL} rel="noopener">Third-party notices</a>
          <a href={LICENSE_URL} rel="noopener">MIT license</a>
        </nav>
        <p class="footer-copy muted">
          © {year} David Ilie · <span class="tnum">{REPO_SLUG}</span>
        </p>
      </div>
    </footer>

    <script>
      import { REPO_SLUG } from "../lib/site.ts";

      // Live star count, best-effort. On any failure the button keeps its
      // server-rendered "Star" label — never a broken number, never a dead link.
      const el = document.querySelector<HTMLElement>("[data-star-count]");
      if (el) {
        const CACHE = "tokmon:stars:v1";
        const paint = (n: number) => {
          el.textContent =
            n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, "") + "k" : String(n);
        };
        const cached = sessionStorage.getItem(CACHE);
        if (cached && /^\d+$/.test(cached)) paint(Number(cached));
        fetch(`https://api.github.com/repos/${REPO_SLUG}`, {
          headers: { Accept: "application/vnd.github+json" },
        })
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            const n = d && typeof d.stargazers_count === "number" ? d.stargazers_count : null;
            if (n !== null) {
              paint(n);
              try {
                sessionStorage.setItem(CACHE, String(n));
              } catch {}
            }
          })
          .catch(() => {});
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--accent);
        color: var(--accent-on);
        padding: 8px 14px;
        border-radius: 0 0 8px 0;
        font-size: 13px;
      }
      .skip-link:focus {
        left: 0;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in oklab, var(--bg-0) 72%, transparent);
        backdrop-filter: saturate(140%) blur(12px);
        -webkit-backdrop-filter: saturate(140%) blur(12px);
        border-bottom: 1px solid var(--line);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 60px;
        gap: 20px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }
      .brand-mark {
        border-radius: 7px;
      }
      .brand-word {
        font-size: 18px;
        color: var(--fg-bright);
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 22px;
        font-size: 14px;
      }
      .nav-links > a {
        color: var(--fg-dim);
        transition: color 160ms ease;
      }
      .nav-links > a:hover,
      .nav-links > a[aria-current="page"] {
        color: var(--fg-bright);
      }
      .nav-download {
        color: var(--accent) !important;
      }
      .star-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border: 1px solid var(--line-2);
        border-radius: 7px;
        color: var(--fg) !important;
        background: var(--bg-2);
        transition: border-color 160ms ease;
      }
      .star-link:hover {
        border-color: var(--accent);
      }
      .star-count {
        min-width: 1.5ch;
      }

      .site-footer {
        margin-top: 96px;
        border-top: 1px solid var(--line);
        background: var(--bg-1);
        padding-block: 32px;
      }
      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px 28px;
      }
      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--fg-bright);
        font-size: 15px;
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 18px;
        font-size: 13px;
      }
      .footer-links a {
        color: var(--fg-dim);
        transition: color 160ms ease;
      }
      .footer-links a:hover {
        color: var(--accent);
      }
      .footer-copy {
        font-size: 12px;
        margin-left: auto;
      }

      @media (max-width: 820px) {
        .nav-links {
          gap: 16px;
        }
        .nav-links > a:not(.nav-docs):not(.nav-download):not(.star-link) {
          display: none;
        }
      }
      @media (max-width: 420px) {
        .nav-links {
          gap: 10px;
        }
        .star-link {
          padding-inline: 8px;
        }
        .star-count {
          display: none;
        }
        .footer-copy {
          margin-left: 0;
        }
      }
    </style>
  </body>
</html>
