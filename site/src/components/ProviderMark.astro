---
import { PROVIDER_MARKS } from "../lib/site.ts";

interface Props {
  id: string;
  name: string;
  size?: number;
}
const { id, name, size = 22 } = Astro.props;
const mark = PROVIDER_MARKS[id];
const monogram = name.trim().slice(0, 2).toUpperCase() || "?";
---

{
  mark ? (
    <svg
      class="pmark"
      viewBox={mark.viewBox}
      width={size}
      height={size}
      role="img"
      aria-label={`${name} mark`}
      fill="currentColor"
      fill-rule={mark.fillRule ?? "nonzero"}
    >
      <path d={mark.path} />
    </svg>
  ) : (
    <span
      class="pmark pmark-mono font-display"
      style={`width:${size}px;height:${size}px`}
      role="img"
      aria-label={`${name} monogram`}
    >
      {monogram}
    </span>
  )
}

<style>
  .pmark {
    display: inline-flex;
    flex: none;
  }
  .pmark-mono {
    align-items: center;
    justify-content: center;
    font-size: 10px;
    border: 1px solid currentColor;
    border-radius: 6px;
    letter-spacing: 0;
  }
</style>
