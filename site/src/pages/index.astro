---
import Layout from "../layouts/Layout.astro";
import CopyCommand from "../components/CopyCommand.astro";
import ProviderMark from "../components/ProviderMark.astro";
import { PROVIDERS, REPO_URL, RELEASES_URL } from "../lib/site.ts";
import { DEFAULT_THEME_ID, SITE_THEMES } from "../lib/theme.ts";

const title = "Tokmon — every token, every limit, one dashboard";
const description =
  "Terminal, web, and menu-bar dashboard for Claude Code, Codex, Cursor, Copilot, opencode, pi, Antigravity, Gemini, and Grok — usage, costs, and rate limits in one place.";
---

<Layout title={title} description={description} active="home">
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy rise">
        <p class="eyebrow">Local-first usage dashboard</p>
        <h1 class="hero-title">
          Every token.<br />Every limit.<br /><span class="accent">One dashboard.</span>
        </h1>
        <p class="hero-sub">
          See cost, tokens, cache savings, and live limits for <strong>Claude Code</strong>,
          <strong>Codex</strong>, <strong>Cursor</strong>, <strong>Copilot</strong>,
          <strong>opencode</strong>, <strong>pi</strong>, <strong>Antigravity</strong>,
          <strong>Gemini</strong>, and <strong>Grok</strong> in one dashboard.
        </p>

        <div class="hero-cta">
          <CopyCommand command="npx tokmon" label="Run tokmon with npx" />
          <!-- Asset-aware desktop CTA: the current latest release has zero
               desktop artifacts, so this renders "coming soon" and links to the
               download page. releases.ts upgrades it live once assets exist. -->
          <a class="btn" href="/download" data-desktop-cta>
            <span data-desktop-cta-label>Desktop app — coming soon</span>
          </a>
        </div>
        <p class="hero-note muted">
          Terminal · web · macOS · Windows · Linux
        </p>
      </div>

      <figure class="hero-shot rise">
        <div class="shot-frame shot-masked">
          <img
            src="/screenshot.webp"
            alt="Tokmon terminal dashboard showing provider cards with cost, token, and rate-limit meters"
            width="1600"
            height="906"
            loading="eager"
          />
        </div>
        <img
          class="shot-tray"
          src="/tray-popover.webp"
          alt="Tokmon menu-bar popover listing providers with quota meters and reset times"
          width="540"
          height="960"
          loading="eager"
        />
      </figure>
    </div>
  </section>

  <!-- ========================= SURFACES ========================= -->
  <section id="surfaces" class="section">
    <div class="wrap">
      <p class="eyebrow">Three surfaces, one shared view</p>
      <h2 class="section-title">Wherever you work, the same numbers.</h2>
      <p class="section-lede muted">
        The CLI, web dashboard, and desktop app share the same usage model and
        settings, so every surface stays consistent.
      </p>

      <div class="surfaces">
        <article class="panel surface">
          <h3 class="surface-h">Terminal</h3>
          <p class="muted">
            An Ink TUI: a reflowing grid of provider cards with sparklines, burn
            rate, cache savings, and live limit bars. Query it headless with
            <code>tokmon usage --json</code> from any script or agent.
          </p>
        </article>
        <article class="panel surface">
          <h3 class="surface-h">Web</h3>
          <p class="muted">
            A local Vite dashboard — charts, calendar heatmap, model breakdowns,
            and full settings. Launch with <code>tokmon serve</code> or toggle it
            from the TUI.
          </p>
        </article>
        <article class="panel surface">
          <h3 class="surface-h">Menu bar</h3>
          <p class="muted">
            A macOS menu-bar strip and Windows / Linux tray that pins your two
            most important quotas and opens a provider-grouped popover — the
            signal, without a terminal.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ========================= PROVIDERS ========================= -->
  <section id="providers" class="section">
    <div class="wrap">
      <p class="eyebrow">Providers</p>
      <h2 class="section-title">All your coding tools, one view.</h2>
      <p class="section-lede muted">
        Compare usage history, spend, plans, and quota resets without switching
        between provider dashboards.
      </p>

      <ul class="provider-grid" role="list">
        {
          PROVIDERS.map((p) => (
            <li class="panel provider-cell">
              <div class="provider-head">
                <span class="provider-mark" style={`color:${p.hue}`}>
                  <ProviderMark id={p.id} name={p.name} size={22} />
                </span>
                <span class="provider-name">{p.name}</span>
              </div>
              <p class="provider-gives muted">{p.gives}</p>
            </li>
          ))
        }
      </ul>
      <p class="provider-foot muted">
        Costs use each model's published pricing (or a tool's own recorded cost).
        Cached tokens are billed at the discounted cache-read rate — so totals
        reflect what you're actually charged.
      </p>
    </div>
  </section>

  <!-- ========================== THEMES ========================== -->
  <section id="themes" class="section">
    <div class="wrap">
      <p class="eyebrow">Appearance</p>
      <div class="theme-head">
        <h2 class="section-title">One appearance, shared everywhere.</h2>
        <button class="theme-reset" type="button" data-theme-reset hidden>Reset to Tokmon</button>
      </div>
      <p class="section-lede muted">
        The daemon owns one theme across terminal, web, and desktop: the Tokmon
        and Phosphor presets, the complete ZeroCut editor-theme catalog,
        OS-following Auto mode, and contrast-checked custom palettes derived from
        any preset.
      </p>

      <ul class="theme-grid" role="radiogroup" aria-label="Preview a theme across this site" data-theme-grid>
        {
          SITE_THEMES.map((theme) => (
            <li>
              <button
                class="theme-chip" type="button" role="radio"
                aria-checked={theme.id === DEFAULT_THEME_ID ? "true" : "false"}
                tabindex={theme.id === DEFAULT_THEME_ID ? 0 : -1}
                data-theme-pick={theme.id}
                style={`background:${theme.bg};color:${theme.fg}`}
              >
                <span class="theme-dot" style={`background:${theme.accent}`} aria-hidden="true" />
                <span class="theme-name">{theme.name}</span>
                <svg class="theme-check" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
                  <path d="M1.5 6.2 4.4 9 10.5 2.8" fill="none" stroke="currentColor" stroke-width="1.6" />
                </svg>
              </button>
            </li>
          ))
        }
      </ul>
      <p class="theme-status" role="status" data-theme-status>
        {SITE_THEMES.find((theme) => theme.id === DEFAULT_THEME_ID)?.name && (
          <strong data-theme-status-name>Tokmon</strong>
        )}<span data-theme-status-copy> — the default palette.</span>
      </p>
      <p class="provider-foot muted">Plus OS-following Auto mode and custom palettes.</p>
    </div>
  </section>

  <!-- ======================== OPEN SOURCE ======================== -->
  <section id="open-source" class="section">
    <div class="wrap os-grid">
      <div>
        <p class="eyebrow">Open source</p>
        <h2 class="section-title">Read the code. Run it locally.</h2>
        <p class="section-lede muted">
          Tokmon is MIT-licensed and built with Ink and TypeScript. Install it
          globally, or clone and build from source.
        </p>
        <div class="os-actions">
          <a class="btn" href={REPO_URL} rel="noopener">View on GitHub</a>
          <a class="btn" href={RELEASES_URL} rel="noopener">Releases</a>
        </div>
      </div>
      <div class="os-cmds">
        <CopyCommand command="npx tokmon" label="Run without installing" />
        <CopyCommand command="npm install -g tokmon" label="Global install" />
        <CopyCommand command="pnpm dlx tokmon" label="Run with pnpm" />
      </div>
    </div>
  </section>

  <!-- ======================== FINAL CTA ========================= -->
  <section class="section">
    <div class="wrap final-cta panel">
      <h2 class="section-title">See your usage in one command.</h2>
      <p class="section-lede muted">
        One command. Open source and MIT-licensed.
      </p>
      <div class="final-cta-row">
        <CopyCommand command="npx tokmon" label="Run tokmon" />
        <a class="btn btn-primary" href="/download">Get the desktop app</a>
      </div>
    </div>
  </section>

  <script>
    import { fetchLatestRelease, hasAnyDesktopAsset } from "../lib/releases.ts";

    // Upgrade the hero desktop CTA when the latest release actually ships
    // installers. Default (server-rendered) state is the honest "coming soon".
    const cta = document.querySelector<HTMLAnchorElement>("[data-desktop-cta]");
    const label = document.querySelector<HTMLElement>("[data-desktop-cta-label]");
    if (cta && label) {
      fetchLatestRelease()
        .then((release) => {
          if (hasAnyDesktopAsset(release)) {
            label.textContent = "Download desktop app";
          }
        })
        .catch(() => {});
    }
  </script>

  <style>
    /* ---------------- hero ---------------- */
    .hero {
      padding-top: 56px;
      padding-bottom: 24px;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      gap: 44px;
      align-items: center;
    }
    .hero-title {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(34px, 5.4vw, 58px);
      line-height: 1.04;
      letter-spacing: 0.01em;
      color: var(--fg-bright);
      margin-top: 14px;
    }
    .hero-title .accent {
      color: var(--accent);
    }
    .hero-sub {
      margin-top: 20px;
      max-width: 54ch;
      color: var(--fg-dim);
      font-size: 16px;
    }
    .hero-sub strong {
      color: var(--fg);
      font-weight: 500;
    }
    .hero-cta {
      margin-top: 26px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
    }
    .hero-note {
      margin-top: 14px;
      font-size: 13px;
    }

    .hero-shot {
      position: relative;
      min-width: 0;
    }
    .shot-frame {
      border: 1px solid var(--line-2);
      border-radius: 14px;
      overflow: hidden;
      background: var(--bg-1);
      box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.8);
    }
    .shot-frame img {
      width: 100%;
      height: auto;
    }
    /* "masked" — fade the dashboard into the page at the lower edge. */
    .shot-masked {
      -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
    }
    .shot-tray {
      position: absolute;
      right: -14px;
      bottom: -26px;
      width: 34%;
      max-width: 190px;
      height: auto;
      border: 1px solid var(--line-2);
      border-radius: 12px;
      box-shadow: 0 20px 44px -20px rgba(0, 0, 0, 0.85);
      background: var(--bg-1);
    }

    /* ---------------- sections ---------------- */
    .section {
      padding-top: 72px;
    }
    .section-title {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(24px, 3.4vw, 34px);
      line-height: 1.12;
      color: var(--fg-bright);
      margin-top: 10px;
      letter-spacing: 0.01em;
    }
    .section-lede {
      margin-top: 14px;
      max-width: 66ch;
      font-size: 15px;
    }
    code {
      font-family: var(--font-mono);
      color: var(--code-fg);
      background: var(--bg-2);
      border: 1px solid var(--line);
      border-radius: 5px;
      padding: 1px 5px;
      font-size: 0.92em;
    }

    /* surfaces */
    .surfaces {
      margin-top: 28px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .surface {
      padding: 20px;
    }
    .surface-h {
      font-family: var(--font-display);
      font-size: 16px;
      color: var(--accent-text);
      margin-bottom: 8px;
    }
    .surface p {
      font-size: 14px;
    }

    /* provider grid */
    .provider-grid {
      margin-top: 28px;
      list-style: none;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
    .provider-cell {
      padding: 16px 16px 18px;
    }
    .provider-head {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .provider-mark {
      display: inline-flex;
    }
    .provider-name {
      font-size: 15px;
      color: var(--fg-bright);
      font-weight: 500;
    }
    .provider-gives {
      margin-top: 12px;
      font-size: 13px;
    }
    .provider-foot {
      margin-top: 22px;
      font-size: 13px;
      max-width: 72ch;
    }

    /* themes */
    .theme-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      min-height: 34px;
    }
    .theme-reset {
      padding: 5px 11px;
      border: 1px solid var(--line-2);
      border-radius: 7px;
      background: var(--bg-2);
      color: var(--fg-dim);
      font: inherit;
      font-size: 12px;
      cursor: pointer;
    }
    .theme-reset[hidden] {
      display: none;
    }
    .theme-reset:hover {
      border-color: var(--accent);
      color: var(--fg-bright);
    }
    .theme-grid {
      margin-top: 28px;
      list-style: none;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 10px;
    }
    .theme-grid > li {
      display: contents;
    }
    .theme-chip {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      padding: 12px 12px;
      border: 1px solid var(--line-2);
      border-radius: 10px;
      position: relative;
      font: inherit;
      font-size: 12px;
      text-align: left;
      cursor: pointer;
      overflow: hidden;
    }
    .theme-chip[aria-checked="true"] {
      border-color: color-mix(in oklab, currentColor 55%, transparent);
      box-shadow: inset 0 0 0 1px color-mix(in oklab, currentColor 30%, transparent);
    }
    .theme-dot {
      width: 10px;
      height: 10px;
      border-radius: 3px;
      flex: none;
    }
    .theme-name {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .theme-check {
      flex: none;
      margin-left: auto;
      opacity: 0;
    }
    .theme-chip[aria-checked="true"] .theme-check {
      opacity: 1;
    }
    .theme-status {
      margin-top: 14px;
      color: var(--fg-dim);
      font-size: 13px;
    }
    .theme-status strong {
      color: var(--fg-bright);
      font-weight: 500;
    }

    /* open source */
    .os-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: start;
    }
    .os-actions {
      margin-top: 22px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    .os-cmds {
      display: grid;
      gap: 12px;
    }

    /* final cta */
    .final-cta {
      padding: 40px;
      text-align: center;
    }
    .final-cta .section-lede {
      margin-inline: auto;
    }
    .final-cta-row {
      margin-top: 24px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    /* ---------------- responsive ---------------- */
    @media (max-width: 960px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 52px;
      }
      .theme-grid {
        grid-template-columns: repeat(4, 1fr);
      }
      .os-grid {
        grid-template-columns: 1fr;
        gap: 28px;
      }
    }
    @media (max-width: 820px) {
      .surfaces {
        grid-template-columns: 1fr;
      }
      .provider-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 560px) {
      .theme-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    @media (max-width: 420px) {
      .provider-grid {
        grid-template-columns: 1fr;
      }
      .theme-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .shot-tray {
        position: static;
        width: 56%;
        margin: 14px auto 0;
      }
      .shot-masked {
        -webkit-mask-image: none;
        mask-image: none;
      }
    }
  </style>
</Layout>
