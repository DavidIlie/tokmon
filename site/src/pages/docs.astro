---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";

const readme = await getEntry("docs", "readme");
if (!readme) throw new Error("The repository README could not be loaded.");

const { Content, headings } = await render(readme);
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<Layout
  title="Documentation · Tokmon"
  description="Install, configure, and use Tokmon across the terminal, web dashboard, and desktop app."
  active="docs"
>
  <section class="docs-hero">
    <div class="wrap docs-hero-inner">
      <p class="eyebrow">Documentation</p>
      <h1>Everything you need to run Tokmon.</h1>
      <p class="lede">
        Install the CLI, connect your coding tools, and explore every dashboard.
        This guide stays in sync with the project README.
      </p>
    </div>
  </section>

  <div class="wrap docs-shell">
    <details class="mobile-toc">
      <summary>On this page</summary>
      <nav aria-label="Documentation sections">
        {toc.map((heading) => (
          <a class:list={[`toc-${heading.depth}`]} href={`#${heading.slug}`}>
            {heading.text}
          </a>
        ))}
      </nav>
    </details>

    <aside class="desktop-toc">
      <p>On this page</p>
      <nav aria-label="Documentation sections">
        {toc.map((heading) => (
          <a class:list={[`toc-${heading.depth}`]} href={`#${heading.slug}`}>
            {heading.text}
          </a>
        ))}
      </nav>
    </aside>

    <article class="readme">
      <Content />
    </article>
  </div>
</Layout>

<style>
  .docs-hero {
    padding: 76px 0 54px;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 10% 20%, color-mix(in oklab, var(--accent) 14%, transparent), transparent 30%),
      var(--bg-0);
  }
  .docs-hero-inner {
    max-width: 780px;
  }
  .docs-hero h1 {
    max-width: 720px;
    margin: 10px 0 16px;
    font-size: clamp(38px, 6vw, 68px);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  .docs-hero .lede {
    max-width: 680px;
    margin: 0;
    color: var(--fg);
    font-size: 18px;
    line-height: 1.65;
  }
  .docs-shell {
    display: grid;
    grid-template-columns: 210px minmax(0, 760px);
    justify-content: center;
    gap: clamp(36px, 7vw, 88px);
    padding-top: 56px;
    padding-bottom: 100px;
  }
  .desktop-toc {
    position: sticky;
    top: 92px;
    align-self: start;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }
  .desktop-toc p {
    margin: 0 0 12px;
    color: var(--fg-bright);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .desktop-toc nav,
  .mobile-toc nav {
    display: grid;
    gap: 2px;
  }
  .desktop-toc a,
  .mobile-toc a {
    padding: 6px 8px;
    border-left: 1px solid var(--line-2);
    color: var(--fg-dim);
    font-size: 13px;
    line-height: 1.35;
  }
  .desktop-toc a:hover,
  .mobile-toc a:hover {
    border-color: var(--accent);
    color: var(--fg-bright);
  }
  .desktop-toc .toc-3,
  .mobile-toc .toc-3 {
    padding-left: 20px;
  }
  .mobile-toc {
    display: none;
  }
  .readme {
    min-width: 0;
    color: var(--fg);
    font-size: 15px;
    line-height: 1.72;
  }
  .readme :global(h2),
  .readme :global(h3) {
    color: var(--fg-bright);
    line-height: 1.15;
    scroll-margin-top: 88px;
  }
  .readme :global(h2) {
    margin: 70px 0 20px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
    font-size: clamp(27px, 4vw, 38px);
    letter-spacing: -0.035em;
  }
  .readme :global(h2:first-of-type) {
    margin-top: 0;
  }
  .readme :global(h3) {
    margin: 38px 0 14px;
    font-size: 21px;
    letter-spacing: -0.02em;
  }
  .readme :global(p),
  .readme :global(ul),
  .readme :global(ol) {
    margin: 0 0 18px;
  }
  .readme :global(ul),
  .readme :global(ol) {
    padding-left: 24px;
  }
  .readme :global(li + li) {
    margin-top: 7px;
  }
  .readme :global(a) {
    color: var(--accent-text);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent-text) 45%, transparent);
    text-underline-offset: 3px;
  }
  .readme :global(strong) {
    color: var(--fg-bright);
  }
  .readme :global(code) {
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--bg-2);
    color: var(--fg-bright);
    padding: 0.13em 0.36em;
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  .readme :global(pre) {
    max-width: 100%;
    margin: 20px 0 24px;
    overflow-x: auto;
    border: 1px solid var(--line-2);
    border-radius: 10px;
    background: var(--bg-1);
    padding: 18px 20px;
  }
  .readme :global(pre code) {
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--fg);
    font-size: 13px;
  }
  .readme :global(pre.astro-code span[style*="#6A737D"]) {
    color: #a3abb8 !important;
  }
  .readme :global(table) {
    display: block;
    width: 100%;
    margin: 22px 0 28px;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 13px;
    white-space: nowrap;
  }
  .readme :global(th),
  .readme :global(td) {
    border-bottom: 1px solid var(--line);
    padding: 10px 14px;
    text-align: left;
  }
  .readme :global(th) {
    color: var(--fg-bright);
  }
  .readme :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 24px 0;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: var(--bg-1);
  }
  @media (max-width: 760px) {
    .docs-hero {
      padding: 54px 0 40px;
    }
    .docs-shell {
      display: block;
      padding-top: 28px;
      padding-bottom: 72px;
    }
    .desktop-toc {
      display: none;
    }
    .mobile-toc {
      display: block;
      margin-bottom: 42px;
      border: 1px solid var(--line-2);
      border-radius: 10px;
      background: var(--bg-1);
      padding: 12px 14px;
    }
    .mobile-toc summary {
      cursor: pointer;
      color: var(--fg-bright);
      font-weight: 650;
    }
    .mobile-toc nav {
      margin-top: 12px;
      max-height: 50vh;
      overflow-y: auto;
    }
    .readme :global(h2) {
      margin-top: 54px;
    }
  }
</style>
