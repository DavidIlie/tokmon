{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shared": ["../web/contract.ts"],
      "@desktop/*": ["./shared/*"]
    },
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["main", "renderer", "shared", "preload.ts", "*.ts"]
}
